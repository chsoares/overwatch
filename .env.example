# OpenRouter API Configuration
OPENROUTER_API_KEY=your_api_key_here

# API Settings
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter model used to classify sectors (must be an available model id)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
MAX_RETRIES=3
RETRY_DELAY=2  # seconds

# NVD API (optional, raises rate limits when set)
NVD_API_KEY=your_nvd_api_key_here

# Logging level for ingestion scripts (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO